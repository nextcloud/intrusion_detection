{
    "openapi": "3.0.3",
    "info": {
        "title": "intrusion_detection",
        "version": "0.0.1",
        "description": "Recognises attacks on logins, shares and accounts, and answers them with graduated, explained responses.",
        "license": {
            "name": "agpl"
        }
    },
    "components": {
        "securitySchemes": {
            "basic_auth": {
                "type": "http",
                "scheme": "basic"
            },
            "bearer_auth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "OCSMeta": {
                "type": "object",
                "required": [
                    "status",
                    "statuscode"
                ],
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "statuscode": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "totalitems": {
                        "type": "string"
                    },
                    "itemsperpage": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "paths": {
        "/ocs/v2.php/apps/intrusion_detection/api/v1/share-alerts/{detectionId}/disable": {
            "post": {
                "operationId": "share_alert-disable",
                "summary": "Turn off the share link a detection is about",
                "description": "Only someone who manages the share can do this; for anyone else the detection does not exist. Turning off a link that is already gone succeeds again.",
                "tags": [
                    "share_alert"
                ],
                "security": [
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "detectionId",
                        "in": "path",
                        "description": "The detection from the notification",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    },
                    {
                        "name": "OCS-APIRequest",
                        "in": "header",
                        "description": "Required to be true for the API request to pass",
                        "required": true,
                        "schema": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The link is off",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "type": "object",
                                                    "required": [
                                                        "status"
                                                    ],
                                                    "properties": {
                                                        "status": {
                                                            "type": "string",
                                                            "enum": [
                                                                "disabled",
                                                                "already_gone"
                                                            ]
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No share link of the current user belongs to this detection",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "type": "object",
                                                    "required": [
                                                        "status"
                                                    ],
                                                    "properties": {
                                                        "status": {
                                                            "type": "string",
                                                            "enum": [
                                                                "not_found"
                                                            ]
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Current user is not logged in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "admin_api",
            "description": "The admin page's API. Administrators only (there is no delegation: this page can turn protection off and lift blocks). Every change needs a recent password confirmation and is written to the audit log."
        },
        {
            "name": "approval",
            "description": "Requests for the approval of a second administrator: the list, and the decisions (also the actions of the approval notification). Administrators only (the default for controllers) and CSRF-protected. A decision needs a recent password confirmation; the rules who may decide are in {@see ApprovalService}, shared with occ."
        },
        {
            "name": "blocklist_api",
            "description": "The firewall export and the blocklists on the Blocks tab. Administrators only; every change needs a recent password confirmation and is audited. The export directory is deliberately not settable here: it is read from config.php only, so a web administrator cannot make Nextcloud write files anywhere on the server."
        },
        {
            "name": "decoy_api",
            "description": "The Decoys tab: decoy credentials, reserved names and trap paths. Administrators only; every change needs a recent password confirmation and is audited. The secret of a decoy is returned once, by the request that creates it, and never stored: no endpoint can return it again."
        },
        {
            "name": "digest_api",
            "description": "The admin page's API for the digest email. Administrators only, like the rest of the admin API."
        },
        {
            "name": "events_api",
            "description": "The admin page's API for the typed events that webhooks can receive. Administrators only, like the rest of the admin API."
        },
        {
            "name": "learning_action",
            "description": "The actions of the \"learning period ends tomorrow\" notification. Administrators only (the default for controllers), CSRF-protected, and idempotent: they act only while that notice is pending. A notification action cannot ask for the password, which is why both actions do only what the notice offered and are written to the audit log."
        },
        {
            "name": "notification_api",
            "description": "The Notifications tab. Administrators only. The settings themselves are changed through the settings endpoint of the admin API."
        },
        {
            "name": "payload_api",
            "description": "The signatures of the injection probe check and \"Test a URL\". Administrators only. Nothing here changes anything: signatures are switched and added through the check's settings, and the tests run the matcher on the server without sending a request or recording anything. They take a body because the input can be long, and are rate limited because they run regular expressions."
        },
        {
            "name": "privacy_api",
            "description": "The \"Data and privacy\" tab. Administrators only; changes need a recent password confirmation and are audited."
        },
        {
            "name": "share_alert",
            "description": "The \"Disable link\" action of the notification that tells someone the password of their share is being guessed."
        },
        {
            "name": "simulation_api",
            "description": "\"Simulate\" on the check cards. Administrators only. A simulation only reads the settings: nothing is recorded, blocked or notified."
        }
    ]
}
