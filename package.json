  "scripts": {
    "build": "vite build",
    "dev": "NODE_ENV=development vite build --mode development",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typescript:generate": "npx openapi-typescript ./openapi-full.json -t -o src/types/openapi/openapi-full.ts",
    "watch": "NODE_ENV=development vite build --mode development --watch"
  },
  "browserslist": [
